---
/**
 * The homepage.
 *
 * Migrated out of the 92 KB hand-written public/index.html. The markup,
 * styling and behaviour are the same bytes that were live before the move —
 * only their location changed. CSS and JS are now real files that a browser
 * can cache and a person can edit without scrolling through markup.
 *
 * The nav, footer and floating buttons are now shared components, and the
 * chrome they depend on lives in base.css and chrome.js. Nothing on this
 * page is duplicated anywhere else in the site.
 */
import '../styles/base.css';
import '../styles/home.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Floats from '../components/Floats.astro';
