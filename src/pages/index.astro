        <rect class="df" x="105" y="88" width="20" height="280" fill="url(#hB)" style="animation-delay:2.15s"/>
        <rect class="dl" pathLength="1" x="105" y="88" width="20" height="280" stroke="#7DA5EB" stroke-width="1.4" style="animation-delay:1.3s"/>
